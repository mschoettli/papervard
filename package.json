    "prisma:deploy": "prisma migrate deploy",
    "db:seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@cornerstonejs/core": "^5.6.1",
    "@cornerstonejs/dicom-image-loader": "^5.6.1",
    "@cornerstonejs/tools": "^5.6.1",
    "@prisma/client": "^5.22.0",
    "archiver": "^7.0.1",
    "bcryptjs": "^2.4.3",
    "clsx": "^2.1.1",
    "dicom-parser": "^1.8.21",
    "lucide-react": "^0.468.0",
    "next": "^15.1.0",
    "pdf-parse": "^1.1.1",
    "prisma": "^5.22.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "server-only": "^0.0.1",
    "sharp": "^0.35.3",
    "tailwind-merge": "^2.5.5",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/archiver": "^6.0.3",

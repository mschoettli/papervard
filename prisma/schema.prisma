generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  extensions = [vector]
}

enum Role {
  admin
  user
}

enum IndexStatus {
  queued
  processing
  indexed
  failed
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  name         String
  passwordHash String
  role         Role     @default(user)
  active       Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  favorites    FavoriteDocument[]
  savedSearches SavedSearch[]
}

model Document {
  id            String      @id @default(cuid())
  title         String
  originalName  String
  year          Int
  mimeType      String
  size          Int
  storagePath   String
  checksum      String      @unique
  pageCount     Int         @default(0)
  indexStatus   IndexStatus @default(queued)
  indexError    String?
  uploadedById  String?
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
  chunks        TextChunk[]
  favorites     FavoriteDocument[]

  @@index([year])
  @@index([indexStatus])
}

model FavoriteDocument {
  id         String   @id @default(cuid())
  userId     String
  documentId String
  createdAt  DateTime @default(now())
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  document   Document @relation(fields: [documentId], references: [id], onDelete: Cascade)

  @@unique([userId, documentId])
  @@index([documentId])
}

model SavedSearch {
  id        String   @id @default(cuid())
  userId    String
  name      String
  query     String
  yearFrom  Int?
  yearTo    Int?
  title     String?
  mode      String   @default("hybrid")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model TextChunk {
  id         String                    @id @default(cuid())
  documentId String
  page       Int
  content    String
  tsv        Unsupported("tsvector")?
  embedding  Unsupported("vector(384)")?
  createdAt  DateTime                  @default(now())
  document   Document                  @relation(fields: [documentId], references: [id], onDelete: Cascade)

  @@index([documentId])
}

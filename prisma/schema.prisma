generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  extensions = [vector]
}

enum Role {
  admin
  user
}

enum IndexStatus {
  queued
  processing
  indexed
  failed
}

enum HouseholdRole {
  owner
  member
}

enum DocumentVisibility {
  private
  family
}

model User {
  id                   String             @id @default(cuid())
  email                String             @unique
  name                 String
  passwordHash         String
  role                 Role               @default(user)
  active               Boolean            @default(true)
  createdAt            DateTime           @default(now())
  updatedAt            DateTime           @updatedAt
  favorites            FavoriteDocument[]
  savedSearches        SavedSearch[]
  householdMemberships HouseholdMember[]
  ownedDocuments       Document[]         @relation("DocumentOwner")
}

model Household {
  id        String            @id @default(cuid())
  name      String
  createdAt DateTime          @default(now())
  updatedAt DateTime          @updatedAt
  members   HouseholdMember[]
  documents Document[]
}

model HouseholdMember {
  id          String        @id @default(cuid())
  householdId String
  userId      String
  role        HouseholdRole @default(member)
  createdAt   DateTime      @default(now())
  household   Household     @relation(fields: [householdId], references: [id], onDelete: Cascade)
  user        User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([householdId, userId])
  @@index([userId])
}

model Document {
  id           String             @id @default(cuid())
  title        String
  originalName String
  year         Int
  yearLocked   Boolean            @default(false)
  mimeType     String
  size         Int
  storagePath  String
  checksum     String
  pageCount    Int                @default(0)
  indexStatus  IndexStatus        @default(queued)
  indexError   String?
  ownerUserId  String
  householdId  String
  visibility   DocumentVisibility @default(private)
  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @updatedAt
  chunks       TextChunk[]
  favorites    FavoriteDocument[]
  owner        User               @relation("DocumentOwner", fields: [ownerUserId], references: [id], onDelete: Cascade)
  household    Household          @relation(fields: [householdId], references: [id], onDelete: Cascade)

  @@unique([ownerUserId, checksum])
  @@index([ownerUserId])
  @@index([householdId, visibility])
  @@index([year])
  @@index([indexStatus])
}

model FavoriteDocument {
  id         String   @id @default(cuid())
  userId     String
  documentId String
  createdAt  DateTime @default(now())
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  document   Document @relation(fields: [documentId], references: [id], onDelete: Cascade)

  @@unique([userId, documentId])
  @@index([documentId])
}

model SavedSearch {
  id        String   @id @default(cuid())
  userId    String
  name      String
  query     String
  yearFrom  Int?
  yearTo    Int?
  title     String?
  mode      String   @default("hybrid")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model TextChunk {
  id         String                      @id @default(cuid())
  documentId String
  page       Int
  content    String
  tsv        Unsupported("tsvector")?
  embedding  Unsupported("vector(384)")?
  createdAt  DateTime                    @default(now())
  document   Document                    @relation(fields: [documentId], references: [id], onDelete: Cascade)

  @@index([documentId])
}
